{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd checkout-backend && npm install && npx prisma generate && npm run build",
    "watchPatterns": [
      "checkout-backend/**"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "cd checkout-backend && node dist/main",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}